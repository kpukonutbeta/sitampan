# Get these from Google Cloud Console -> Credentials -> OAuth 2.0 Client IDs (Desktop App)
GOOGLE_DRIVE_CREDENTIALS_FILE=gdrive.json
GOOGLE_DRIVE_TOKEN_FILE=token.json

# The ID of the root folder in Google Drive where all categories should be created
# (It's the long string in the folder URL: drive.google.com/drive/folders/<THIS_IS_THE_ID>)
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_root_folder_id_here
